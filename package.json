{
  "name": "fern",
  "version": "1.5.5",
  "description": "Fern — notas, quadros visuais e organização em um só lugar.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.brunozess.fern",
    "productName": "Fern",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BrunoZess",
        "repo": "Fern",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^4.10.38"
  }
}
